# ==============================================================================
# Fubika — arquivo ÚNICO de variáveis de ambiente
# ==============================================================================
#
# Copie para `.env` na RAIZ do repositório: esse é o único arquivo de variáveis
# por máquina. Não existe mais `.env` dentro de services/* nem de infra/.
#
#   cp .env.example .env
#
# Quem lê este arquivo:
#   - Docker Compose (os compose files vivem na raiz, então ele acha o .env sozinho)
#   - API e bot em dev local, via `node/tsx --env-file=../../.env`
#   - Vite (web), via `envDir` apontando para a raiz — só variáveis VITE_*
#   - bancho, via `env_file:` no compose (lê dezenas de configs de jogo)
#
# REGRAS DE SINTAXE (o parser do Compose é literal):
#   - sem espaço em volta do `=`
#   - valor com espaço precisa de aspas duplas: TLS_OPTS="tls internal"
#     (o Compose remove as aspas; sem elas, `source .env` no terminal quebra)
#   - `$` em senha precisa ser escrito `$$` (ou evite `$` de vez)
#   - `#` no meio de um valor sem aspas começa comentário: evite
#   - DB_PASS e REDIS_PASS entram em URLs (mysql://… redis://…): use apenas
#     letras e números, senão caracteres como @ : / ? # quebram a URL
#   - rode `make env-check` para conferir tudo isso de uma vez
#
# ==============================================================================
# 1. AMBIENTE
# ==============================================================================

# Qual ambiente esta máquina representa: dev | staging | production
ENV=dev

# Nome do projeto Docker (prefixo dos containers, volumes e redes).
COMPOSE_PROJECT_NAME=fubika

# Quais arquivos compose este ambiente usa. É isto que permite rodar
# `docker compose up -d` no servidor sem nenhuma flag.
#   dev ......... docker-compose.yml:docker-compose.dev.yml
#   staging ..... docker-compose.yml:docker-compose.staging.yml
#   produção .... docker-compose.yml:docker-compose.prod.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Separador usado em COMPOSE_FILE. No Linux o padrão já é ":", mas deixamos
# explícito porque no Docker Desktop para Windows (inclusive via WSL) o padrão
# é ";" e o COMPOSE_FILE acima seria lido como um nome de arquivo único.
COMPOSE_PATH_SEPARATOR=:

# ==============================================================================
# 2. DOMÍNIO / TLS
# ==============================================================================

# Domínio base do ambiente. Todo o resto é derivado dele:
# api.<DOMAIN>, a.<DOMAIN> (avatares), assets.<DOMAIN>, c.<DOMAIN> (bancho).
#   dev ......... localhost
#   staging ..... staging.fubika.com.br
#   produção .... fubika.com.br
DOMAIN=localhost

# E-mail da conta ACME (Let's Encrypt) usada pelo Caddy.
ACME_EMAIL=hassis.moreira117@gmail.com

# Opções de TLS do Caddy.
#   dev ................... tls internal   (certificado local do Caddy)
#   staging e produção .... vazio          (certificado real via Let's Encrypt)
TLS_OPTS="tls internal"

# ==============================================================================
# 3. IMAGENS
# ==============================================================================

# Tag das imagens em ghcr.io/henrique117/fubika-{bancho,api,bot,web,backup}.
# Em dev isso é só um rótulo local. Em staging/produção o deploy sobrescreve
# com o SHA do commit (ou com prod-<sha> em rollback).
TAG=dev

# ==============================================================================
# 4. MYSQL
# ==============================================================================

DB_NAME=fubika
DB_USER=fubika
DB_PASS=troque_esta_senha
DB_ROOT_PASS=troque_esta_senha_root

# ==============================================================================
# 5. REDIS
# ==============================================================================

# Obrigatório. O Redis sobe com --requirepass e API/bot/bancho autenticam.
REDIS_PASS=troque_esta_senha_redis

# ==============================================================================
# 6. API
# ==============================================================================

# Segredo de assinatura dos JWT. Obrigatório (sem ele a API usa um padrão fraco).
JWT_SECRET=troque_este_segredo
JWT_EXPIRES_IN=7d

# Chave de API que o bot usa para falar com a API (tabela api_keys).
API_KEY=

# Discord ID do dono (ganha privilégios de admin nas rotas protegidas).
OWNER_DISCORD_ID=

# Usuário inicial criado pelo seed do Prisma (`npx prisma db seed`).
# Usado só na máquina do dev / no primeiro seed de um banco novo.
FIRST_USER_NAME=
FIRST_USER_EMAIL=
FIRST_USER_PASS=

# ==============================================================================
# 7. OSU! API
# ==============================================================================

OSU_API_KEY=
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# ==============================================================================
# 8. DISCORD
# ==============================================================================

# Token do bot. Em produção é o "Fubas"; em staging o "Fubas Staging";
# em dev, o bot pessoal de cada desenvolvedor.
DISCORD_TOKEN=

# Application ID (client id) do mesmo bot.
CLIENT_ID=

# Se preenchido, os slash commands são registrados SÓ nesta guild
# (atualização instantânea — ideal para bot de teste).
# Vazio = registro global (produção/staging).
DISCORD_GUILD_ID=

# Webhook de auditoria do bancho (opcional).
DISCORD_AUDIT_LOG_WEBHOOK=

# ==============================================================================
# 9. GROQ (LLM do bot)
# ==============================================================================

GROQ_API_KEY=

# ==============================================================================
# 10. BACKUP
# ==============================================================================

# Hora (00-23) em que o serviço de backup roda, no fuso TZ abaixo.
BACKUP_HOUR=04

# Quantos dias de backup manter em ./backups.
RETENTION_DAYS=7

TZ=America/Sao_Paulo

# ==============================================================================
# 11. DEV LOCAL (nada disso é usado em staging/produção)
# ==============================================================================

# Domínio de onde o dev consome API/avatares/assets ao rodar o web ou o bot
# na máquina (`make web`, `make bot`). O proxy do Vite aponta para
# https://api.<VITE_DEV_DOMAIN>.
VITE_DEV_DOMAIN=staging.fubika.com.br

# Banco/Redis que a API local usa (`make api` e `make api-local`).
# Portas 3307/6380 = túnel SSH do staging (`make tunnel-staging`).
# Para rodar contra os containers locais do `make deps`, use 3306/6379.
LOCAL_DATABASE_URL=mysql://fubika:troque_esta_senha@127.0.0.1:3307/fubika
LOCAL_REDIS_URL=redis://default:troque_esta_senha_redis@127.0.0.1:6380/0

# Servidor de staging, usado pelo `make tunnel-staging`.
STAGING_SSH_HOST=
STAGING_SSH_USER=deploy

# ==============================================================================
# 12. CONFIGS DO JOGO (bancho)
# ==============================================================================

# Espelhos de download de mapas.
MIRROR_SEARCH_ENDPOINT=https://catboy.best/api/search
MIRROR_DOWNLOAD_ENDPOINT=https://catboy.best/d

# Prefixo dos comandos in-game (!help, !top, ...).
COMMAND_PREFIX=!

# Planos de fundo da tela de login (lista separada por vírgula).
SEASONAL_BGS=https://i.cmyui.xyz/T74WiQG5wVyf.jpg,https://i.cmyui.xyz/nrMT4V2RR3PR.jpeg

# Ícone e link do menu principal do jogo.
# Se deixar vazio, o compose deriva de assets.<DOMAIN> / <DOMAIN>.
MENU_ICON_URL=
MENU_ONCLICK_URL=

# Accuracies pré-calculadas de PP.
PP_CACHED_ACCS=90,95,98,99,100

# Listas de bloqueio (separadas por vírgula).
DISALLOWED_NAMES=
DISALLOWED_PASSWORDS=

DISALLOW_OLD_CLIENTS=False
DISALLOW_INGAME_REGISTRATION=True
REDIRECT_OSU_URLS=True

# Datadog (opcional, pode ficar vazio).
DATADOG_API_KEY=
DATADOG_APP_KEY=

AUTOMATICALLY_REPORT_PROBLEMS=False
LOG_WITH_COLORS=True
DEBUG=False

# ATENÇÃO: só ligue em dev. Expõe rotas perigosas.
DEVELOPER_MODE=False
