[mysqld]
# Compatibilidade com o driver do bancho: ele fala com o MySQL via
# `databases[mysql]` -> aiomysql/PyMySQL autenticando com mysql_native_password,
# enquanto o padrão do MySQL 8 é caching_sha2_password.
#
# Este é o ÚNICO lugar onde esse ajuste existe. Antes ele estava duplicado aqui
# e no `command:` do compose, o que escondia qual dos dois valia.
#
# Nota: no MySQL 8.0 esta opção gera um aviso de "deprecated" e no 8.4 ela foi
# removida (lá o equivalente é `authentication_policy`). Ao subir de major,
# migre esta linha junto.
default_authentication_plugin=mysql_native_password
